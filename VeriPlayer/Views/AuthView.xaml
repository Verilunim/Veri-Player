<UserControl x:Class="VeriPlayer.Views.AuthView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:VeriPlayer.Controls"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d">
    <Grid>
        <Border Style="{StaticResource GlassPanel}" Width="980" MaxHeight="660" Margin="40"
                HorizontalAlignment="Center" VerticalAlignment="Center" ClipToBounds="True">
            <Border.Effect>
                <DropShadowEffect BlurRadius="70" ShadowDepth="12" Opacity="0.65" Color="Black" />
            </Border.Effect>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.02*" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>

                <!-- левая, декоративная -->
                <Grid Grid.Column="0" ClipToBounds="True">
                    <Border CornerRadius="22,0,0,22">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="{DynamicResource AccentColor}" Offset="0" />
                                <GradientStop Color="{DynamicResource AccentColor2}" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>

                    <Canvas ClipToBounds="True">
                        <Ellipse Canvas.Left="-140" Canvas.Top="-160" Width="460" Height="460" Opacity="0.35">
                            <Ellipse.Fill>
                                <RadialGradientBrush>
                                    <GradientStop Color="#FFFFFFFF" Offset="0" />
                                    <GradientStop Color="#00FFFFFF" Offset="1" />
                                </RadialGradientBrush>
                            </Ellipse.Fill>
                        </Ellipse>
                        <Ellipse Canvas.Left="330" Canvas.Top="440" Width="420" Height="420" Opacity="0.28">
                            <Ellipse.Fill>
                                <RadialGradientBrush>
                                    <GradientStop Color="#FF000000" Offset="0" />
                                    <GradientStop Color="#00000000" Offset="1" />
                                </RadialGradientBrush>
                            </Ellipse.Fill>
                        </Ellipse>
                    </Canvas>

                    <StackPanel Margin="46,44,40,40">
                        <StackPanel>
                            <TextBlock Text="veri" FontSize="34" FontWeight="Black" FontStyle="Italic" Foreground="White" />
                            <TextBlock Text="MUSIC PLAYER" FontSize="11" FontWeight="SemiBold" Foreground="#D9FFFFFF"
                                       Margin="2,-2,0,0" />
                        </StackPanel>

                        <TextBlock Text="Своя музыка.&#10;Своя атмосфера." FontSize="34" FontWeight="Bold"
                                   Foreground="#FFFFFF" Margin="0,40,0,0" LineHeight="42" />

                        <TextBlock Text="Загрузите треки, выберите цвет и живой фон — и слушайте в удовольствие."
                                   Foreground="#E8E8F5" FontSize="13.5" TextWrapping="Wrap" Margin="0,16,0,0"
                                   LineHeight="21" MaxWidth="330" HorizontalAlignment="Left" />

                        <StackPanel Margin="0,36,0,0">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                <Path Data="{StaticResource IconSparkle}" Width="20" Height="20" Stretch="None"
                                      Stroke="#FFFFFF" StrokeThickness="1.7" StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round" StrokeLineJoin="Round" VerticalAlignment="Center" />
                                <TextBlock Text="Снег, дождь, листья, сакура и звёзды" Foreground="#F2F2FA" FontSize="13"
                                           Margin="12,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                <Path Data="{StaticResource IconPalette}" Width="20" Height="20" Stretch="None"
                                      Stroke="#FFFFFF" StrokeThickness="1.7" StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round" StrokeLineJoin="Round" VerticalAlignment="Center" />
                                <TextBlock Text="RGB-настройка интерфейса" Foreground="#F2F2FA" FontSize="13"
                                           Margin="12,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                <Path Data="{StaticResource IconImage}" Width="20" Height="20" Stretch="None"
                                      Stroke="#FFFFFF" StrokeThickness="1.7" StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round" StrokeLineJoin="Round" VerticalAlignment="Center" />
                                <TextBlock Text="Свой фон от 1920 × 1080" Foreground="#F2F2FA" FontSize="13"
                                           Margin="12,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconSpotify}" Width="20" Height="20" Stretch="None"
                                      Stroke="#FFFFFF" StrokeThickness="1.7" StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round" StrokeLineJoin="Round" VerticalAlignment="Center" />
                                <TextBlock Text="Подключение Spotify-аккаунта" Foreground="#F2F2FA" FontSize="13"
                                           Margin="12,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <!-- правая, форма -->
                <Grid Grid.Column="1" Margin="42,38,42,34">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" x:Name="TabHost" SizeChanged="TabHost_SizeChanged">
                        <Border x:Name="TabUnderline" Height="2" CornerRadius="1"
                                Background="{DynamicResource AccentGradientBrush}" HorizontalAlignment="Left"
                                VerticalAlignment="Bottom" Margin="0,0,0,-1">
                            <Border.RenderTransform>
                                <TranslateTransform x:Name="TabUnderlineShift" />
                            </Border.RenderTransform>
                        </Border>
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="TabLogin" Style="{StaticResource BtnTab}" Content="Вход" Click="TabLogin_Click" />
                            <Button x:Name="TabRegister" Style="{StaticResource BtnTab}" Content="Регистрация"
                                    Click="TabRegister_Click" />
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="1" Margin="0,26,0,0">
                        <!-- вход -->
                        <StackPanel x:Name="LoginPanel">
                            <TextBlock Text="С возвращением" Style="{StaticResource TextH1}" FontSize="26" />
                            <TextBlock Text="Войдите, чтобы вернуться к своей коллекции." Style="{StaticResource TextMuted}"
                                       Margin="0,8,0,0" />

                            <TextBlock Text="Логин" Style="{StaticResource FieldLabel}" Margin="2,26,0,6" />
                            <TextBox x:Name="LoginNick" MaxLength="24" />

                            <TextBlock Text="Пароль" Style="{StaticResource FieldLabel}" Margin="2,16,0,6" />
                            <PasswordBox x:Name="LoginPassword" />

                            <StackPanel x:Name="LoginError" Orientation="Horizontal" Margin="2,14,0,0" Visibility="Collapsed">
                                <Path Data="{StaticResource IconInfo}" Width="16" Height="16" Stretch="None"
                                      Stroke="{DynamicResource DangerBrush}" StrokeThickness="1.7"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      VerticalAlignment="Top" Margin="0,1,0,0" />
                                <TextBlock x:Name="LoginErrorText" Foreground="{DynamicResource DangerBrush}" FontSize="12.5"
                                           TextWrapping="Wrap" Margin="8,0,0,0" MaxWidth="300" />
                            </StackPanel>

                            <Button x:Name="BtnLogin" Style="{StaticResource BtnPrimary}" Content="Войти" Margin="0,22,0,0"
                                    Height="44" Click="BtnLogin_Click" />

                            <TextBlock Margin="0,18,0,0" Style="{StaticResource TextMuted}">
                                <Run Text="Впервые здесь?" />
                                <Hyperlink Click="LinkToRegister_Click" Foreground="{DynamicResource AccentTextBrush}"
                                           TextDecorations="None"><Run Text="Создать аккаунт" /></Hyperlink>
                            </TextBlock>
                        </StackPanel>

                        <!-- регистрация -->
                        <ScrollViewer x:Name="RegisterPanel" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock x:Name="RegTitle" Text="Создать аккаунт" Style="{StaticResource TextH1}" FontSize="26" />
                                <TextBlock x:Name="RegSubtitle" Text="Ник, пароль, аватар и пара слов о себе." TextWrapping="Wrap" Style="{StaticResource TextMuted}"
                                           Margin="0,8,0,0" />

                                <StackPanel Orientation="Horizontal" Margin="0,22,0,0">
                                    <controls:AvatarView x:Name="RegAvatar" Size="64" Ring="True" />
                                    <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                                        <Button Style="{StaticResource BtnChip}" Content="Выбрать аватар" Click="PickAvatar_Click" />
                                        <TextBlock x:Name="RegAvatarHint" Text="PNG или JPG, обрежется по кругу"
                                                   Style="{StaticResource TextCaption}" Margin="2,7,0,0" />
                                    </StackPanel>
                                </StackPanel>

                                <TextBlock Text="Ник" Style="{StaticResource FieldLabel}" Margin="2,20,0,6" />
                                <TextBox x:Name="RegNick" MaxLength="24" />

                                <Grid Margin="0,16,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="14" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Пароль" Style="{StaticResource FieldLabel}" Margin="2,0,0,6" />
                                        <PasswordBox x:Name="RegPassword" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Повторите пароль" Style="{StaticResource FieldLabel}" Margin="2,0,0,6" />
                                        <PasswordBox x:Name="RegPassword2" />
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="О себе (bio)" Style="{StaticResource FieldLabel}" Margin="2,16,0,6" />
                                <TextBox x:Name="RegBio" AcceptsReturn="True" Height="66" MaxLength="220"
                                         TextWrapping="Wrap" VerticalContentAlignment="Top" />

                                <StackPanel x:Name="RegError" Orientation="Horizontal" Margin="2,14,0,0" Visibility="Collapsed">
                                    <Path Data="{StaticResource IconInfo}" Width="16" Height="16" Stretch="None"
                                          Stroke="{DynamicResource DangerBrush}" StrokeThickness="1.7"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                          VerticalAlignment="Top" Margin="0,1,0,0" />
                                    <TextBlock x:Name="RegErrorText" Foreground="{DynamicResource DangerBrush}" FontSize="12.5"
                                               TextWrapping="Wrap" Margin="8,0,0,0" MaxWidth="300" />
                                </StackPanel>

                                <Button x:Name="BtnRegister" Style="{StaticResource BtnPrimary}" Content="Создать аккаунт"
                                        Margin="0,22,0,10" Height="44" Click="BtnRegister_Click" />
                                <TextBlock x:Name="RegLoginLink" Margin="0,0,0,10" Style="{StaticResource TextMuted}">
                                    <Run Text="Уже есть аккаунт?" />
                                    <Hyperlink Click="LinkToLogin_Click" Foreground="{DynamicResource AccentTextBrush}"
                                               TextDecorations="None"><Run Text="Войти" /></Hyperlink>
                                </TextBlock>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- обязательная смена стандартного пароля -->
                        <StackPanel x:Name="ChangePanel" Visibility="Collapsed">
                            <TextBlock Text="Смените пароль" Style="{StaticResource TextH1}" FontSize="26" />
                            <TextBlock x:Name="ChangeSubtitle" Style="{StaticResource TextMuted}" TextWrapping="Wrap"
                                       Margin="0,8,0,0" />

                            <TextBlock Text="Новый пароль" Style="{StaticResource FieldLabel}" Margin="2,24,0,6" />
                            <PasswordBox x:Name="ChangePassword1" />
                            <TextBlock Text="Повторите пароль" Style="{StaticResource FieldLabel}" Margin="2,16,0,6" />
                            <PasswordBox x:Name="ChangePassword2" KeyDown="ChangePassword_KeyDown" />

                            <StackPanel x:Name="ChangeError" Orientation="Horizontal" Margin="2,14,0,0" Visibility="Collapsed">
                                <Path Data="{StaticResource IconInfo}" Width="16" Height="16" Stretch="None"
                                      Stroke="{DynamicResource DangerBrush}" StrokeThickness="1.7"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      VerticalAlignment="Top" Margin="0,1,0,0" />
                                <TextBlock x:Name="ChangeErrorText" Foreground="{DynamicResource DangerBrush}" FontSize="12.5"
                                           TextWrapping="Wrap" Margin="8,0,0,0" MaxWidth="300" />
                            </StackPanel>

                            <Button Style="{StaticResource BtnPrimary}" Content="Сохранить и войти" Margin="0,22,0,0"
                                    Height="44" Click="BtnChange_Click" />
                            <TextBlock Margin="0,18,0,0" Style="{StaticResource TextMuted}">
                                <Hyperlink Click="ChangeCancel_Click" Foreground="{DynamicResource AccentTextBrush}"
                                           TextDecorations="None"><Run Text="Войти в другой аккаунт" /></Hyperlink>
                            </TextBlock>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
