<Window x:Class="VeriPlayer.Views.KeyGeneratorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ключи Pro+"
        Icon="pack://application:,,,/VeriPlayer;component/Assets/logo.png"
        Width="720" Height="820"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="True" WindowStartupLocation="CenterOwner"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="Segoe UI Variable Display, Segoe UI, Arial" FontSize="13.5">
    <Border Margin="18" CornerRadius="22" Background="{DynamicResource BgBrush}"
            BorderBrush="#40FFD45C" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="36" ShadowDepth="8" Opacity="0.6" Color="Black" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="24,18,14,6" Background="Transparent" MouseLeftButtonDown="Header_MouseDown">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Ключи" Style="{StaticResource TextH1}" FontSize="20" />
                        <TextBlock Text="Pro" Style="{StaticResource TextH1}" FontSize="20" Margin="8,0,0,0"
                                   Foreground="{StaticResource GoldBrush}" />
                        <TextBlock Style="{StaticResource ProPlusMark}" FontSize="24" Margin="1,-4,0,0" />
                    </StackPanel>
                    <TextBlock Text="Выпуск и проверка ключей подписки. Доступно только владельцу и со-владельцу."
                               Style="{StaticResource TextCaption}" Margin="0,4,0,0" />
                </StackPanel>
                <Button Style="{StaticResource BtnIconSmall}" HorizontalAlignment="Right" VerticalAlignment="Top"
                        ToolTip="Закрыть" Click="Close_Click">
                    <Path Data="{StaticResource IconClose}" Style="{StaticResource IconBase}" Width="15" Height="15"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                </Button>
            </Grid>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,16">
                <StackPanel Margin="24,8,24,8">

                    <!-- ===== API-ключ выпуска ===== -->
                    <Border Style="{StaticResource Card}" Padding="16,13">
                        <StackPanel>
                            <TextBlock Text="API-ключ выпуска" Style="{StaticResource FieldLabel}" Margin="0,0,0,6" />
                            <Grid x:Name="ApiKeyRow">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <PasswordBox x:Name="ApiKeyBox" MaxLength="60" KeyDown="ApiKey_KeyDown"
                                             ToolTip="XXXXXXXXXXXXXXXXXXXX-XXXXXXXXXXXXXXXXXXXX" />
                                <Button x:Name="UnlockButton" Grid.Column="1" Content="Разблокировать"
                                        Style="{StaticResource BtnPrimary}" Margin="10,0,0,0" Click="Unlock_Click" />
                            </Grid>
                            <TextBlock x:Name="SignerStatus" Style="{StaticResource TextCaption}" TextWrapping="Wrap"
                                       Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- ===== выпуск ===== -->
                    <TextBlock Text="Выпустить ключ" Style="{StaticResource TextH2}" FontSize="16" Margin="2,20,0,10" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Ник пользователя" Style="{StaticResource FieldLabel}" />
                            <TextBox x:Name="NickBox" MaxLength="24" Height="38" Padding="13,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Срок подписки" Style="{StaticResource FieldLabel}" />
                            <ComboBox x:Name="TermBox" SelectionChanged="Term_Changed">
                                <ComboBoxItem Content="7 дней" Tag="7" />
                                <ComboBoxItem Content="30 дней" Tag="30" IsSelected="True" />
                                <ComboBoxItem Content="90 дней" Tag="90" />
                                <ComboBoxItem Content="180 дней" Tag="180" />
                                <ComboBoxItem Content="1 год" Tag="365" />
                                <ComboBoxItem Content="До выбранной даты…" Tag="date" />
                                <ComboBoxItem Content="Бессрочно" Tag="lifetime" />
                            </ComboBox>
                        </StackPanel>
                    </Grid>

                    <StackPanel x:Name="DateRow" Margin="0,12,0,0" Visibility="Collapsed">
                        <TextBlock Text="Последний день действия (дд.мм.гггг)" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="DateBox" MaxLength="10" Width="180" HorizontalAlignment="Left"
                                 TextChanged="Date_Changed" />
                    </StackPanel>

                    <TextBlock x:Name="TermSummary" Foreground="{StaticResource GoldBrush}" FontWeight="SemiBold"
                               Margin="2,12,0,0" />

                    <StackPanel x:Name="IssueError" Orientation="Horizontal" Margin="2,10,0,0" Visibility="Collapsed">
                        <Path Data="{StaticResource IconInfo}" Width="16" Height="16" Stretch="Uniform"
                              Stroke="{DynamicResource DangerBrush}" StrokeThickness="1.7"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                        <TextBlock x:Name="IssueErrorText" Foreground="{DynamicResource DangerBrush}" FontSize="12.5"
                                   TextWrapping="Wrap" Margin="8,0,0,0" MaxWidth="560" />
                    </StackPanel>

                    <Button x:Name="IssueButton" Content="Создать ключ" Style="{StaticResource BtnPrimary}"
                            HorizontalAlignment="Left" Margin="0,14,0,0" Click="Issue_Click" />

                    <StackPanel x:Name="ResultRow" Margin="0,14,0,0" Visibility="Collapsed">
                        <TextBlock Text="Готовый ключ — отправьте его пользователю" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="ResultBox" IsReadOnly="True" Height="70" TextWrapping="Wrap"
                                 VerticalContentAlignment="Top" FontFamily="Consolas" FontSize="11.5" />
                        <Button Content="Копировать ключ" Style="{StaticResource BtnGhost}" HorizontalAlignment="Left"
                                Margin="0,10,0,0" Click="CopyResult_Click" />
                    </StackPanel>

                    <!-- ===== проверка ===== -->
                    <TextBlock Text="Определить срок ключа" Style="{StaticResource TextH2}" FontSize="16" Margin="2,26,0,10" />
                    <TextBox x:Name="InspectBox" Height="64" TextWrapping="Wrap" VerticalContentAlignment="Top"
                             FontFamily="Consolas" FontSize="11.5" />
                    <Button Content="Проверить" Style="{StaticResource BtnGhost}" HorizontalAlignment="Left"
                            Margin="0,10,0,0" Click="Inspect_Click" />
                    <TextBlock x:Name="InspectResult" Style="{StaticResource TextBody}" TextWrapping="Wrap"
                               LineHeight="21" Margin="2,10,0,0" Visibility="Collapsed" />

                    <!-- ===== журнал ===== -->
                    <TextBlock Text="Выданные ключи" Style="{StaticResource TextH2}" FontSize="16" Margin="2,26,0,10" />
                    <ListBox x:Name="IssuedList" MaxHeight="200">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Line}" Margin="10,7" FontSize="12.5"
                                           Foreground="{DynamicResource TextBrush}" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock x:Name="NoIssued" Text="Пока ни одного ключа не выпущено" Style="{StaticResource TextCaption}"
                               Margin="2,6,0,0" Visibility="Collapsed" />
                    <Button Content="Копировать выбранный ключ" Style="{StaticResource BtnGhost}" HorizontalAlignment="Left"
                            Margin="0,10,0,0" Click="CopyIssued_Click" />
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>
