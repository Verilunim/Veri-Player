<UserControl x:Class="VeriPlayer.Views.Panels.ConfirmPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d">
    <StackPanel Margin="26,4,26,24" Width="430">
        <StackPanel Orientation="Horizontal">
            <Border Width="40" Height="40" CornerRadius="13" Background="#26FF5A6E" VerticalAlignment="Top">
                <Path Data="{StaticResource IconTrash}" Width="20" Height="20" Stretch="Uniform" Stroke="#FFB3BD"
                      StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      StrokeLineJoin="Round" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <TextBlock x:Name="Question" Style="{StaticResource TextBody}" TextWrapping="Wrap" Width="340"
                       Margin="14,4,0,0" VerticalAlignment="Center" />
        </StackPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
            <Button Content="Отмена" Style="{StaticResource BtnGhost}" Click="Cancel_Click" />
            <Button x:Name="ConfirmButton" Content="Удалить" Style="{StaticResource BtnDanger}"
                    Margin="10,0,0,0" Click="Confirm_Click" />
        </StackPanel>
    </StackPanel>
</UserControl>
