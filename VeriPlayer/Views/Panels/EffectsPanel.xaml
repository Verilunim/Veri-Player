<UserControl x:Class="VeriPlayer.Views.Panels.EffectsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d">
    <StackPanel Margin="26,4,26,24" Width="600">
        <TextBlock Text="Выберите эффект, который будет жить на фоне"
                   Style="{StaticResource TextMuted}" />

        <ItemsControl x:Name="EffectList" Margin="0,16,0,0">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
        </ItemsControl>

        <Border Height="1" Background="{DynamicResource HairlineBrush}" Margin="0,18,0,16" />

        <Grid>
            <TextBlock Text="Насыщенность эффекта" Style="{StaticResource FieldLabel}" />
            <TextBlock x:Name="IntensityText" Style="{StaticResource TextCaption}" HorizontalAlignment="Right" />
        </Grid>
        <Slider x:Name="IntensitySlider" Minimum="15" Maximum="120" ValueChanged="Intensity_Changed" />

        <CheckBox x:Name="VisualizerToggle" Content="Показывать спектр звука" Margin="0,18,0,0"
                  Click="Visualizer_Click" />

        <CheckBox x:Name="MotionToggle" Content="Уменьшить движение (спокойный фон)" Margin="0,12,0,0"
                  Click="Motion_Click" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
            <Button Content="Готово" Style="{StaticResource BtnPrimary}" Click="Done_Click" />
        </StackPanel>
    </StackPanel>
</UserControl>
