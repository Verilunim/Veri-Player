<UserControl x:Class="VeriPlayer.Views.Panels.GenerateMusicPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="32,24,32,32" MaxWidth="960">

            <TextBlock Text="Создать песню с AI" Style="{StaticResource TextH2}" />
            <TextBlock Style="{StaticResource TextMuted}" TextWrapping="Wrap" Margin="0,8,0,0"
                       Text="Опишите стиль песни и текст — AI создаст 2 варианта за ~1 минуту. Для генерации нужен API ключ Suno." />

            <!-- API ключ -->
            <Border Style="{StaticResource Card}" Background="#0AFFFFFF" Padding="16,12" Margin="0,16,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Suno API ключ" Style="{StaticResource FieldLabel}" Margin="0,0,0,6" />
                        <TextBox x:Name="ApiKeyBox" Height="32"
                                 ToolTip="Получите на sunoapi.com (от $5)" />
                    </StackPanel>
                    <Button Grid.Column="1" Style="{StaticResource BtnGhost}" Content="Сохранить" 
                            Margin="14,20,0,0" Padding="16,0" Height="36" Click="SaveApiKey_Click" />
                </Grid>
            </Border>

            <!-- Промпт стиля -->
            <TextBlock Text="Стиль песни" Style="{StaticResource FieldLabel}" Margin="0,24,0,8" />
            <TextBox x:Name="StylePromptBox" Height="72" TextWrapping="Wrap" AcceptsReturn="True"
                     VerticalContentAlignment="Top" Padding="12,10"
                     Text="energetic pop with 80s synth, upbeat tempo, catchy chorus" />
            <TextBlock Style="{StaticResource TextCaption}" Margin="0,6,0,0" TextWrapping="Wrap"
                       Text="Примеры: 'acoustic folk ballad', 'heavy metal with orchestral elements', 'lo-fi hip-hop beats', 'epic cinematic trailer music'" />

            <!-- Текст песни -->
            <Grid Margin="0,20,0,0">
                <TextBlock Text="Текст песни" Style="{StaticResource FieldLabel}" />
                <CheckBox x:Name="InstrumentalCheck" Content="Инструментальная" HorizontalAlignment="Right"
                          Foreground="{DynamicResource TextBrush}" Checked="InstrumentalCheck_Changed" Unchecked="InstrumentalCheck_Changed" />
            </Grid>
            
            <TextBox x:Name="LyricsBox" Height="160" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,8,0,0"
                     VerticalContentAlignment="Top" Padding="12,10" VerticalScrollBarVisibility="Auto"
                     Text="Verse 1:&#x0a;Walking down the street at night&#x0a;City lights are shining bright&#x0a;&#x0a;Chorus:&#x0a;We're alive, we're alive tonight" />
            <TextBlock Style="{StaticResource TextCaption}" Margin="0,6,0,0" TextWrapping="Wrap"
                       Text="Укажите структуру: Verse, Chorus, Bridge. Можно на русском или английском (англ. рекомендуется для лучшего качества)." />

            <!-- Ползунки -->
            <Grid Margin="0,20,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <Grid>
                        <TextBlock Text="Странность" Style="{StaticResource FieldLabel}" />
                        <TextBlock x:Name="WeirdnessText" Style="{StaticResource TextCaption}" HorizontalAlignment="Right" Text="50%" />
                    </Grid>
                    <Slider x:Name="WeirdnessSlider" Minimum="0" Maximum="100" Value="50" Margin="0,6,0,0" ValueChanged="Weirdness_Changed" />
                    <TextBlock Style="{StaticResource TextCaption}" Margin="0,4,0,0" TextWrapping="Wrap"
                               Text="Экспериментальность. 0% — традиционная структура, 100% — необычный стиль." />
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <Grid>
                        <TextBlock Text="Вовлечение в стиль" Style="{StaticResource FieldLabel}" />
                        <TextBlock x:Name="AdherenceText" Style="{StaticResource TextCaption}" HorizontalAlignment="Right" Text="70%" />
                    </Grid>
                    <Slider x:Name="AdherenceSlider" Minimum="0" Maximum="100" Value="70" Margin="0,6,0,0" ValueChanged="Adherence_Changed" />
                    <TextBlock Style="{StaticResource TextCaption}" Margin="0,4,0,0" TextWrapping="Wrap"
                               Text="Строгость жанра. 0% — смешанный стиль, 100% — чистый жанр." />
                </StackPanel>
            </Grid>

            <!-- Негативный промпт -->
            <TextBlock Text="Убрать из песни (необязательно)" Style="{StaticResource FieldLabel}" Margin="0,20,0,8" />
            <TextBox x:Name="NegativePromptBox" Height="56" TextWrapping="Wrap" AcceptsReturn="True"
                     VerticalContentAlignment="Top" Padding="12,10"
                     Text="" />
            <TextBlock Style="{StaticResource TextCaption}" Margin="0,6,0,0" TextWrapping="Wrap"
                       Text="Перечислите инструменты/стили для исключения. Пример: 'guitar, drums, vocals'" />

            <!-- Кнопки -->
            <StackPanel Orientation="Horizontal" Margin="0,24,0,0">
                <Button x:Name="GenerateButton" Style="{StaticResource BtnPrimary}" Content="Создать 2 варианта"
                        Click="Generate_Click" />
                <Button Style="{StaticResource BtnGhost}" Content="Закрыть" Margin="12,0,0,0"
                        Click="Close_Click" />
            </StackPanel>

            <!-- Результаты -->
            <StackPanel x:Name="ResultsPanel" Margin="0,32,0,0" Visibility="Collapsed">
                <Border Height="1" Background="{DynamicResource HairlineBrush}" Margin="0,0,0,24" />
                
                <TextBlock Text="Результаты генерации" Style="{StaticResource TextH3}" />
                
                <ItemsControl x:Name="ResultsList" Margin="0,16,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}" Margin="0,0,0,16" Padding="20">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Обложка -->
                                    <Border Width="84" Height="84" CornerRadius="12" ClipToBounds="True"
                                            Background="{DynamicResource AccentDeepBrush}">
                                        <Grid>
                                            <TextBlock Text="AI" FontWeight="Bold" FontSize="28" Foreground="#EAF0FF"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            <Image x:Name="TrackImage" Stretch="UniformToFill" />
                                        </Grid>
                                    </Border>

                                    <!-- Инфо -->
                                    <StackPanel Grid.Column="1" Margin="18,0,18,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextBrush}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding StatusText}" Style="{StaticResource TextCaption}" Margin="0,4,0,0" />
                                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                            <TextBlock Text="Статус:" Style="{StaticResource TextCaption}" />
                                            <TextBlock x:Name="StatusLabel" Text="{Binding Status}" Style="{StaticResource TextCaption}"
                                                       Margin="6,0,0,0" FontWeight="SemiBold" />
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Кнопки -->
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                        <Button x:Name="PlayButton" Style="{StaticResource BtnGhost}" Content="▶ Прослушать"
                                                Click="Play_Click" Tag="{Binding}" Margin="0,0,0,8" />
                                        <Button x:Name="AddButton" Style="{StaticResource BtnPrimary}" Content="+ В библиотеку"
                                                Click="AddToLibrary_Click" Tag="{Binding}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
