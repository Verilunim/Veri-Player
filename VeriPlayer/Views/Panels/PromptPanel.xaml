<UserControl x:Class="VeriPlayer.Views.Panels.PromptPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d">
    <StackPanel Margin="26,4,26,24" Width="430">
        <TextBlock x:Name="Label" Style="{StaticResource FieldLabel}" />
        <TextBox x:Name="Input" MaxLength="60" KeyDown="Input_KeyDown" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Отмена" Style="{StaticResource BtnGhost}" Click="Cancel_Click" />
            <Button x:Name="ConfirmButton" Content="Создать" Style="{StaticResource BtnPrimary}"
                    Margin="10,0,0,0" Click="Confirm_Click" />
        </StackPanel>
    </StackPanel>
</UserControl>
