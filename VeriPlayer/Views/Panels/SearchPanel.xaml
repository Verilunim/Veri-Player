<UserControl x:Class="VeriPlayer.Views.Panels.SearchPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <Style x:Key="ResultItem" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bg" Background="Transparent" Padding="10,7">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource HoverBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="40,18,26,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="ПОИСК МУЗЫКИ" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource TextFaintBrush}" />
            <TextBlock Text="Найдите песню" FontSize="40" FontWeight="Bold" Margin="0,6,0,0"
                       Foreground="{DynamicResource TextBrush}" />
            <TextBlock Style="{StaticResource TextMuted}" Margin="2,6,0,0" TextWrapping="Wrap" MaxWidth="640" HorizontalAlignment="Left"
                       Text="Открытая музыка, которую авторы разрешили слушать и скачивать: Jamendo, Internet Archive и другие каталоги Creative Commons." />
        </StackPanel>

        <!-- строка поиска -->
        <Grid Grid.Row="1" Margin="0,20,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MaxWidth="560" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Height="44" CornerRadius="22" BorderBrush="#B3FFFFFF" BorderThickness="1.5" Background="Transparent">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="QueryBox" Style="{StaticResource BareTextBox}" Padding="20,0,6,0" FontSize="14"
                             VerticalAlignment="Center" KeyDown="Query_KeyDown" TextChanged="Query_Changed" />
                    <TextBlock x:Name="QueryHint" Text="Исполнитель, название или жанр — например, lo-fi, piano, jazz"
                               Foreground="{DynamicResource TextFaintBrush}" FontSize="13" VerticalAlignment="Center"
                               Margin="22,0,6,0" IsHitTestVisible="False" />
                    <Path Grid.Column="1" Data="{StaticResource IconSearch}" Style="{StaticResource IconBase}"
                          Width="18" Height="18" Stroke="{DynamicResource TextBrush}" Margin="0,0,16,0" />
                </Grid>
            </Border>
            <Button x:Name="SearchButton" Grid.Column="1" Content="Найти" Style="{StaticResource BtnPrimary}"
                    Margin="12,0,0,0" Height="44" Padding="26,0" Click="Search_Click" />
        </Grid>

        <!-- результаты -->
        <Grid Grid.Row="2" Margin="0,18,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal">
                <ItemsControl x:Name="Filters">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
                <TextBlock x:Name="StatusText" Style="{StaticResource TextCaption}" VerticalAlignment="Center" Margin="6,0,0,0" />
            </StackPanel>

            <ListBox x:Name="Results" Grid.Row="1" Margin="0,12,0,0" ItemContainerStyle="{StaticResource ResultItem}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="54" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="64" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Button Width="36" Height="36" Cursor="Hand" Click="Play_Click" Tag="{Binding}"
                                    Visibility="{Binding CanPlay, Converter={StaticResource BoolToVis}}"
                                    ToolTip="Слушать сразу, без скачивания" VerticalAlignment="Center">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Dot" CornerRadius="18" Background="White">
                                            <Path Data="{StaticResource IconPlay}" Width="11" Height="11" Stretch="Uniform"
                                                  Fill="#2D2926" Margin="2,0,0,0"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Dot" Property="Background" Value="#EDE7E1" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <Border Grid.Column="1" Width="42" Height="42" Margin="12,0,0,0" Background="#26FFFFFF"
                                    HorizontalAlignment="Left">
                                <Grid>
                                    <TextBlock Text="{Binding Initial}" FontSize="16" FontWeight="Bold" Foreground="#B3FFFFFF"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <Image Source="{Binding Cover}" Stretch="UniformToFill" />
                                </Grid>
                            </Border>

                            <StackPanel Grid.Column="2" Margin="12,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Title}" FontSize="13.5" Foreground="{DynamicResource TextBrush}"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Meta}" FontSize="11.5" Foreground="{DynamicResource TextMutedBrush}"
                                           TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                            </StackPanel>

                            <TextBlock Grid.Column="3" Text="{Binding Duration}" FontSize="12" VerticalAlignment="Center"
                                       HorizontalAlignment="Right" Margin="0,0,14,0" Foreground="{DynamicResource TextFaintBrush}" />

                            <Button Grid.Column="4" Content="{Binding ActionText}" Style="{StaticResource BtnGhost}"
                                    Width="128" Height="34" Padding="0" Click="Download_Click" Tag="{Binding}"
                                    ToolTip="Скачать в библиотеку и включить (Bandcamp — открыть на сайте)" VerticalAlignment="Center" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <TextBlock x:Name="EmptyText" Grid.Row="1" Style="{StaticResource TextMuted}" TextAlignment="Center"
                       TextWrapping="Wrap" MaxWidth="460" HorizontalAlignment="Center" VerticalAlignment="Center"
                       Text="Введите запрос и нажмите «Найти». Любой трек можно сразу послушать или скачать в библиотеку." />
        </Grid>

        <TextBlock x:Name="Attribution" Grid.Row="3" Style="{StaticResource TextCaption}" TextWrapping="Wrap" Margin="2,12,0,0"
                   Text="Jamendo и Internet Archive — музыка по лицензиям Creative Commons и в общественном достоянии: автор, лицензия и источник сохраняются у трека (NC — без коммерческого использования). Bandcamp открывается на сайте: купите релиз или заберите бесплатный — скачанный файл из «Загрузок» сам появится в библиотеке." />
    </Grid>
</UserControl>
