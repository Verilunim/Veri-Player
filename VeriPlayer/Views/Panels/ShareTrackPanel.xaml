<UserControl x:Class="VeriPlayer.Views.Panels.ShareTrackPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d">
    <ScrollViewer MaxHeight="700" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="26,4,26,22" Width="620">

            <TextBlock Text="Поделиться треком" Style="{StaticResource TextH3}" />
            <TextBlock Style="{StaticResource TextMuted}" TextWrapping="Wrap" Margin="0,6,0,0"
                       Text="Отправьте ссылку другу или покажите QR-код. В Veri Player есть отдельная вкладка «Добавить по ссылке», где трек принимается." />

            <!-- выбранный трек -->
            <Border Style="{StaticResource Card}" Background="#0AFFFFFF" Padding="14" Margin="0,14,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="52" Height="52" CornerRadius="12" ClipToBounds="True"
                            Background="{DynamicResource AccentDeepBrush}">
                        <Grid>
                            <TextBlock x:Name="CoverInitial" FontWeight="SemiBold" FontSize="20" Foreground="#EAF0FF"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Image x:Name="CoverImage" Stretch="UniformToFill" />
                        </Grid>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="TrackTitle" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextBrush}" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="TrackArtist" Style="{StaticResource TextCaption}" Margin="0,3,0,0"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- две колонки: слева способ и ссылка, справа QR -->
            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,18,0">
                    <TextBlock Text="Что передаём" Style="{StaticResource FieldLabel}" Margin="0,0,0,8" />
                    <RadioButton x:Name="ModeMeta" Content="Ссылку (метаданные)" IsChecked="True"
                                 Foreground="{DynamicResource TextBrush}" Checked="Mode_Changed" />
                    <RadioButton x:Name="ModeFull" Content="Ссылку вместе с файлом" Margin="0,6,0,0"
                                 Foreground="{DynamicResource TextBrush}" Checked="Mode_Changed" />
                    <TextBlock Style="{StaticResource TextCaption}" TextWrapping="Wrap" Margin="0,8,0,0"
                               Text="С файлом — получатель сразу услышит звук. Такая ссылка длинная." />

                    <TextBlock Text="Ссылка" Style="{StaticResource FieldLabel}" Margin="0,16,0,6" />
                    <TextBox x:Name="LinkBox" IsReadOnly="True" TextWrapping="NoWrap" Height="32" />
                    <Button Style="{StaticResource BtnGhost}" Content="Копировать ссылку" HorizontalAlignment="Left"
                            Margin="0,8,0,0" Click="CopyLink_Click" />
                </StackPanel>

                <Border Grid.Column="1" Background="#0AFFFFFF" CornerRadius="14" Padding="12" VerticalAlignment="Top">
                    <StackPanel>
                        <Border Background="White" CornerRadius="8" Padding="8">
                            <Image x:Name="QrImage" Width="190" Height="190"
                                   RenderOptions.BitmapScalingMode="NearestNeighbor" />
                        </Border>
                        <TextBlock x:Name="QrHint" Style="{StaticResource TextCaption}" Margin="0,10,0,0"
                                   TextWrapping="Wrap" MaxWidth="190" TextAlignment="Center" />
                    </StackPanel>
                </Border>
            </Grid>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <Button Style="{StaticResource BtnGhost}" Content="Сохранить QR картинкой" Click="SaveQr_Click" />
                <Button Style="{StaticResource BtnPrimary}" Content="Готово" Margin="10,0,0,0" Click="Done_Click" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
