<UserControl x:Class="VeriPlayer.Views.Panels.SpotifyPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d">

    <UserControl.Resources>
        <Style x:Key="ServiceItem" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bg" CornerRadius="12" Background="Transparent" Padding="10,8">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#0FFFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer MaxHeight="660" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="26,4,26,24" Width="600">

            <!-- ============================== Spotify ============================== -->
            <StackPanel Orientation="Horizontal">
                <Border Width="38" Height="38" CornerRadius="12" Background="#1921C062">
                    <Path Data="{StaticResource IconSpotify}" Width="20" Height="20" Stretch="Uniform"
                          Fill="#5BEA8C" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Spotify" Style="{StaticResource TextH3}" />
                    <TextBlock x:Name="SpotifyStatus" Text="Не подключено" Style="{StaticResource TextCaption}" />
                </StackPanel>
            </StackPanel>

            <Border Style="{StaticResource Card}" Background="#0AFFFFFF" Padding="14" Margin="0,14,0,0">
                <StackPanel>
                    <TextBlock Style="{StaticResource TextMuted}" TextWrapping="Wrap"
                               Text="Veri Player подключается к вашему аккаунту напрямую, без посредников. Официальный Spotify API не позволяет играть музыку внутри сторонних программ, поэтому треки мы открываем в самом Spotify." />

                    <TextBlock Text="Client ID вашего приложения Spotify" Style="{StaticResource FieldLabel}"
                               Margin="0,16,0,6" />
                    <TextBox x:Name="ClientIdBox" MaxLength="64" />
                    <TextBlock Style="{StaticResource TextCaption}" TextWrapping="Wrap" Margin="2,7,0,0"
                               Text="Создайте приложение на developer.spotify.com → Dashboard → Create app. В поле Redirect URI укажите адрес ниже." />

                    <TextBlock Text="Redirect URI" Style="{StaticResource FieldLabel}" Margin="0,14,0,6" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="RedirectBox" Grid.Column="0" IsReadOnly="True" />
                        <Button Grid.Column="1" Style="{StaticResource BtnGhost}" Content="Копировать"
                                Margin="8,0,0,0" Click="CopyRedirect_Click" />
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="8,0,0,0"
                                    VerticalAlignment="Center">
                            <TextBlock Text="порт" Style="{StaticResource TextCaption}" VerticalAlignment="Center"
                                       Margin="0,0,8,0" />
                            <TextBox x:Name="PortBox" Width="76" MaxLength="5" TextChanged="Port_Changed" />
                        </StackPanel>
                    </Grid>

                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                        <Button x:Name="ConnectButton" Style="{StaticResource BtnPrimary}" Click="Connect_Click"
                                Content="Подключить Spotify" />
                        <Button x:Name="DisconnectButton" Style="{StaticResource BtnGhost}" Margin="10,0,0,0"
                                Click="Disconnect_Click" Content="Отключить" Visibility="Collapsed" />
                        <Button x:Name="PlaylistsButton" Style="{StaticResource BtnGhost}" Margin="10,0,0,0"
                                Click="Playlists_Click" Content="Мои плейлисты" Visibility="Collapsed" />
                    </StackPanel>

                    <TextBlock x:Name="SpotifyHint" Style="{StaticResource TextCaption}" TextWrapping="Wrap"
                               Margin="2,12,0,0" />
                </StackPanel>
            </Border>

            <StackPanel x:Name="PlaylistsHost" Margin="0,14,0,0" Visibility="Collapsed" />

            <!-- ============================== Яндекс Музыка ============================== -->
            <StackPanel Orientation="Horizontal" Margin="0,24,0,0">
                <Border Width="38" Height="38" CornerRadius="12" Background="#26FF3D3D">
                    <Path Data="{StaticResource IconNote}" Width="20" Height="20" Stretch="Uniform"
                          Stroke="#FF7A7A" StrokeThickness="1.5" HorizontalAlignment="Center"
                          VerticalAlignment="Center" />
                </Border>
                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Яндекс Музыка" Style="{StaticResource TextH3}" />
                    <TextBlock Text="официального API для плееров нет" Style="{StaticResource TextCaption}" />
                </StackPanel>
            </StackPanel>

            <Border Style="{StaticResource Card}" Background="#0AFFFFFF" Padding="14" Margin="0,14,0,0">
                <StackPanel>
                    <TextBlock Style="{StaticResource TextMuted}" TextWrapping="Wrap"
                               Text="У Яндекс Музыки нет публичного API, поэтому напрямую подключиться, как к Spotify, нельзя. Зато можно импортировать список любимых композиций — Veri Player найдёт совпадения среди ваших файлов и соберёт плейлист." />
                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                        <Button Style="{StaticResource BtnGhost}" Click="YandexImport_Click">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconExport}" Width="16" Height="16" Stretch="None"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round" />
                                <TextBlock Text="Импортировать список .m3u" Margin="8,0,0,0" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <TextBlock Style="{StaticResource TextCaption}" TextWrapping="Wrap" Margin="2,10,0,0"
                               Text="Подойдёт список .m3u/.m3u8, сохранённый из любого сервиса. Совпадения определяются по имени файла." />
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button Content="Готово" Style="{StaticResource BtnPrimary}" Click="Done_Click" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
