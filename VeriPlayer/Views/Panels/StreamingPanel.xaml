<UserControl x:Class="VeriPlayer.Views.Panels.StreamingPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="RowItem" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bg" Background="Transparent" Padding="10,7" Cursor="Hand">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource HoverBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="40,18,26,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- заголовок -->
        <Grid Grid.Row="0">
            <StackPanel>
                <TextBlock x:Name="Kicker" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource TextFaintBrush}" />
                <TextBlock x:Name="Headline" FontSize="40" FontWeight="Bold" Margin="0,6,0,0"
                           Foreground="{DynamicResource TextBrush}" />
                <TextBlock x:Name="Status" Style="{StaticResource TextMuted}" Margin="2,6,0,0" />
            </StackPanel>
            <Button x:Name="DisconnectButton" Content="Отключить" Style="{StaticResource BtnGhost}"
                    HorizontalAlignment="Right" VerticalAlignment="Top" Click="Disconnect_Click" Visibility="Collapsed" />
        </Grid>

        <!-- подключение -->
        <ScrollViewer x:Name="ConnectView" Grid.Row="1" Margin="0,22,0,0" VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="620" HorizontalAlignment="Left">
                <TextBlock x:Name="Intro" Style="{StaticResource TextMuted}" TextWrapping="Wrap" LineHeight="20" />

                <TextBlock Text="Client ID" Style="{StaticResource FieldLabel}" Margin="2,20,0,6" />
                <TextBox x:Name="ClientIdBox" />
                <TextBlock Text="Client Secret" Style="{StaticResource FieldLabel}" Margin="2,14,0,6" />
                <PasswordBox x:Name="ClientSecretBox" />

                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="120" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Redirect URI (укажите в настройках приложения)" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="RedirectBox" IsReadOnly="True" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Порт" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="PortBox" MaxLength="5" TextChanged="Port_Changed" />
                    </StackPanel>
                </Grid>

                <TextBlock x:Name="Steps" Style="{StaticResource TextCaption}" TextWrapping="Wrap" LineHeight="19" Margin="2,12,0,0" />

                <TextBlock x:Name="ConnectError" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap"
                           Margin="2,14,0,0" Visibility="Collapsed" />

                <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                    <Button x:Name="ConnectButton" Content="Подключить" Style="{StaticResource BtnPrimary}" Click="Connect_Click" />
                    <Button x:Name="PortalButton" Style="{StaticResource BtnGhost}" Margin="10,0,0,0" Click="Portal_Click" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- библиотека сервиса -->
        <Grid x:Name="LibraryView" Grid.Row="1" Margin="0,18,0,0" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal">
                <Button x:Name="BackButton" Style="{StaticResource BtnRound}" Margin="0,0,12,0" Click="Back_Click"
                        Visibility="Collapsed" ToolTip="Назад">
                    <Path Data="{StaticResource IconChevronRight}" Width="12" Height="12" Stretch="Uniform" Stroke="White"
                          StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" RenderTransformOrigin="0.5,0.5">
                        <Path.RenderTransform>
                            <ScaleTransform ScaleX="-1" />
                        </Path.RenderTransform>
                    </Path>
                </Button>
                <ItemsControl x:Name="Tabs">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
                <TextBlock x:Name="ListTitle" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextBrush}" Visibility="Collapsed" />
            </StackPanel>

            <ListBox x:Name="Rows" Grid.Row="1" Margin="0,14,0,0" ItemContainerStyle="{StaticResource RowItem}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="Rows_SelectionChanged"
                     PreviewMouseRightButtonUp="Rows_RightClick">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="44" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Width="40" Height="40" Background="#26FFFFFF" HorizontalAlignment="Left">
                                <Grid>
                                    <Path Data="{Binding Icon}" Width="16" Height="16" Stretch="Uniform" Stroke="White"
                                          StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <Image Source="{Binding Cover}" Stretch="UniformToFill" />
                                </Grid>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Title}" FontSize="13.5" Foreground="{DynamicResource TextBrush}"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Subtitle}" FontSize="11.5" Foreground="{DynamicResource TextMutedBrush}"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="{Binding Right}" FontSize="12" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextFaintBrush}" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <TextBlock x:Name="ListMessage" Grid.Row="1" Style="{StaticResource TextMuted}" TextWrapping="Wrap"
                       HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" MaxWidth="460"
                       Visibility="Collapsed" />
        </Grid>

        <!-- источник: по правилам SoundCloud — автор, логотип/название и ссылка -->
        <TextBlock x:Name="Attribution" Grid.Row="2" Style="{StaticResource TextCaption}" Margin="2,12,0,0"
                   TextWrapping="Wrap" Visibility="Collapsed" />
    </Grid>
</UserControl>
