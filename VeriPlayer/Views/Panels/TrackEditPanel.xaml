<UserControl x:Class="VeriPlayer.Views.Panels.TrackEditPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d">
    <StackPanel Margin="26,4,26,24" Width="520">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border x:Name="CoverHost" Grid.Column="0" Width="76" Height="76" CornerRadius="14"
                    ClipToBounds="True">
                <Grid>
                    <TextBlock x:Name="CoverInitial" FontWeight="SemiBold" FontSize="24" Foreground="#EAF0FF"
                               HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.8" />
                    <Image x:Name="CoverImage" Stretch="UniformToFill" />
                </Grid>
            </Border>
            <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                <TextBlock x:Name="FileNameText" Style="{StaticResource TextMuted}" TextWrapping="Wrap"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="FileMetaText" Style="{StaticResource TextCaption}" Margin="0,6,0,0" />
            </StackPanel>
        </Grid>

        <TextBlock Text="Название" Style="{StaticResource FieldLabel}" Margin="0,20,0,6" />
        <TextBox x:Name="TitleBox" MaxLength="180" />

        <Grid Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="Исполнитель" Style="{StaticResource FieldLabel}" Margin="0,0,0,6" />
                <TextBox x:Name="ArtistBox" MaxLength="120" />
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="Альбом" Style="{StaticResource FieldLabel}" Margin="0,0,0,6" />
                <TextBox x:Name="AlbumBox" MaxLength="120" />
            </StackPanel>
        </Grid>

        <Grid Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="140" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="Жанр" Style="{StaticResource FieldLabel}" Margin="0,0,0,6" />
                <TextBox x:Name="GenreBox" MaxLength="60" />
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="Год" Style="{StaticResource FieldLabel}" Margin="0,0,0,6" />
                <TextBox x:Name="YearBox" MaxLength="4" />
            </StackPanel>
        </Grid>

        <TextBlock Text="Обложка и клип" Style="{StaticResource FieldLabel}" Margin="0,18,0,8" />

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource RowCard}" Padding="12,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="46" Height="46" CornerRadius="10" ClipToBounds="True"
                            Background="{DynamicResource AccentDeepBrush}">
                        <Grid>
                            <TextBlock x:Name="MediaCoverInitial" Text="♪" FontWeight="SemiBold" FontSize="16"
                                       Foreground="#EAF0FF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Image x:Name="MediaCoverImage" Stretch="UniformToFill" />
                        </Grid>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Обложка" FontSize="12.5" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextBrush}" />
                        <TextBlock x:Name="CoverStateText" Style="{StaticResource TextCaption}" Margin="0,2,0,0"
                                   Text="нет" TextTrimming="CharacterEllipsis" />
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <Button x:Name="CoverPickButton" Content="Выбрать" Style="{StaticResource BtnGhost}"
                                    Padding="10,5" FontSize="11.5" Click="CoverPick_Click" />
                            <Button x:Name="CoverClearButton" Content="Убрать" Style="{StaticResource BtnGhost}"
                                    Padding="10,5" FontSize="11.5" Margin="6,0,0,0" Click="CoverClear_Click" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource RowCard}" Padding="12,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="46" Height="46" CornerRadius="10" Background="{DynamicResource AccentFaintBrush}"
                            BorderBrush="{DynamicResource AccentBorderBrush}" BorderThickness="1">
                        <Path Data="{StaticResource IconFilm}" Width="16" Height="16" Stretch="Uniform"
                              Stroke="{DynamicResource AccentTextBrush}" StrokeThickness="1.6"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Клип на фон" FontSize="12.5" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextBrush}" />
                        <TextBlock x:Name="ClipStateText" Style="{StaticResource TextCaption}" Margin="0,2,0,0"
                                   Text="нет · MP4 до 5 с" TextTrimming="CharacterEllipsis" />
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <Button x:Name="ClipPickButton" Content="Прикрепить" Style="{StaticResource BtnGhost}"
                                    Padding="10,5" FontSize="11.5" Click="ClipPick_Click" />
                            <Button x:Name="ClipClearButton" Content="Убрать" Style="{StaticResource BtnGhost}"
                                    Padding="10,5" FontSize="11.5" Click="ClipClear_Click" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <TextBlock x:Name="Hint" Style="{StaticResource TextCaption}" TextWrapping="Wrap" Margin="2,14,0,0"
                   Text="Изменения сохраняются только в библиотеке Veri Player — сам файл не затрагивается." />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Отмена" Style="{StaticResource BtnGhost}" Click="Cancel_Click" />
            <Button Content="Сохранить" Style="{StaticResource BtnPrimary}" Margin="10,0,0,0" Click="Save_Click" />
        </StackPanel>
    </StackPanel>
</UserControl>
