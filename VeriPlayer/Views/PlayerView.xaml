<UserControl x:Class="VeriPlayer.Views.PlayerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:VeriPlayer.Controls"
             xmlns:conv="clr-namespace:VeriPlayer.Converters"
             xmlns:models="clr-namespace:VeriPlayer.Models"
             mc:Ignorable="d"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DesignHeight="700" d:DesignWidth="1100"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008">

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
        <conv:InverseBoolToVisibilityConverter x:Key="InvBoolToVis" />

        <Style x:Key="TrackItem" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <ContentPresenter />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MiniToggle" TargetType="ToggleButton" BasedOn="{StaticResource ToggleIconButton}">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
        </Style>

        <DataTemplate x:Key="TrackRowTemplate">
            <Border x:Name="Row" CornerRadius="12" Padding="10,7"
                    MouseLeftButtonUp="Row_MouseLeftButtonUp"
                    MouseRightButtonUp="Row_MouseRightButtonUp"
                    Cursor="Hand">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="Transparent" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#0FFFFFFF" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="36" />
                        <ColumnDefinition Width="50" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="70" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- номер / кнопка воспроизведения -->
                    <Grid Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding IndexText}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   FontSize="12" Foreground="{DynamicResource TextFaintBrush}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                                     Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <Path Data="{StaticResource IconPlay}" Fill="{DynamicResource AccentTextBrush}"
                              Width="15" Height="15" Stretch="Uniform" HorizontalAlignment="Center"
                              VerticalAlignment="Center" Visibility="Collapsed">
                            <Path.Style>
                                <Style TargetType="Path">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                                     Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Path.Style>
                        </Path>
                    </Grid>

                    <!-- обложка -->
                    <Border Grid.Column="1" Width="42" Height="42" CornerRadius="10"
                            Background="{Binding CoverBrush}" ClipToBounds="True">
                        <Grid>
                            <TextBlock Text="{Binding Initial}" FontWeight="SemiBold" FontSize="16"
                                       Foreground="#EAF0FF" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Opacity="0.85" />
                            <Image Source="{Binding Cover}" Stretch="UniformToFill" />
                        </Grid>
                    </Border>

                    <!-- название -->
                    <StackPanel Grid.Column="2" Margin="13,0,12,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}" FontSize="13.5" TextTrimming="CharacterEllipsis">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Missing}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource WarnBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Artist}" FontSize="11.5"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       TextTrimming="CharacterEllipsis" MaxWidth="280" />
                            <TextBlock Text=" · " FontSize="11.5" Foreground="{DynamicResource TextFaintBrush}" />
                            <TextBlock Text="{Binding Album}" FontSize="11.5"
                                       Foreground="{DynamicResource TextFaintBrush}"
                                       TextTrimming="CharacterEllipsis" MaxWidth="220" />
                        </StackPanel>
                    </StackPanel>

                    <!-- кто добавил -->
                    <Border Grid.Column="3" Style="{StaticResource SoftChip}" VerticalAlignment="Center"
                            Margin="0,0,10,0" MaxWidth="150">
                        <TextBlock Text="{Binding AddedByName}" FontSize="11"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   TextTrimming="CharacterEllipsis" />
                    </Border>

                    <TextBlock Grid.Column="4" Text="{Binding DurationText}" FontSize="12"
                               Foreground="{DynamicResource TextFaintBrush}" VerticalAlignment="Center"
                               HorizontalAlignment="Right" Margin="0,0,10,0" />

                    <ToggleButton Grid.Column="5" Style="{StaticResource MiniToggle}" IsChecked="{Binding IsFavorite, Mode=OneWay}"
                                  Click="RowFavorite_Click" ToolTip="В избранное" Width="34" Height="34">
                        <Path Data="{StaticResource IconHeart}" Width="17" Height="17" Stretch="Uniform" StrokeThickness="1.6"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round">
                            <Path.Style>
                                <Style TargetType="Path">
                                    <Setter Property="Stroke" Value="{DynamicResource TextFaintBrush}" />
                                    <Setter Property="Fill" Value="Transparent" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                                            <Setter Property="Stroke" Value="{DynamicResource AccentTextBrush}" />
                                            <Setter Property="Fill" Value="{DynamicResource AccentBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Path.Style>
                        </Path>
                    </ToggleButton>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ================= главный блок: трек крупно, обложка справа ================= -->
        <Grid x:Name="Hero" Grid.Row="0" Height="318" Margin="0,4,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.92*" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>

            <!-- большая обложка до правого края, без скруглений -->
            <Grid Grid.Column="1" Margin="0,0,0,46" ClipToBounds="True">
                <Rectangle x:Name="HeroCoverFill" Fill="#A89C93" />
                <TextBlock x:Name="HeroCoverInitial" FontSize="150" FontWeight="Black" Foreground="#40FFFFFF"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                <Image x:Name="HeroCover" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" />
            </Grid>

            <!-- текст слева -->
            <StackPanel x:Name="HeroText" Grid.Column="0" Margin="40,22,24,0" VerticalAlignment="Top">
                <TextBlock x:Name="HeroLabel" Text="СЕЙЧАС ИГРАЕТ" FontSize="11.5" FontWeight="Bold"
                           Foreground="{DynamicResource TextFaintBrush}" />
                <TextBlock x:Name="HeroTitle" FontSize="44" FontWeight="Bold" LineHeight="50"
                           LineStackingStrategy="BlockLineHeight" TextWrapping="Wrap" MaxHeight="104"
                           TextTrimming="CharacterEllipsis" Margin="0,10,0,0"
                           Foreground="{DynamicResource TextBrush}" />
                <TextBlock x:Name="HeroMeta" FontSize="13" LineHeight="20" TextWrapping="Wrap" MaxWidth="400"
                           HorizontalAlignment="Left" Margin="2,14,0,0" Foreground="{DynamicResource TextMutedBrush}" />

                <Button x:Name="HeroPlay" Margin="2,22,0,0" HorizontalAlignment="Left" Cursor="Hand"
                        Click="HeroPlay_Click" ToolTip="Слушать">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <StackPanel Orientation="Horizontal" Background="Transparent">
                                <Border x:Name="Dot" Width="34" Height="34" CornerRadius="17" Background="White">
                                    <Path x:Name="HeroPlayGlyph" Data="{StaticResource IconPlay}" Width="12" Height="12"
                                          Stretch="Uniform" Fill="#2D2926" Margin="2,0,0,0"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock x:Name="HeroPlayText" Text="СЛУШАТЬ" FontSize="11.5" FontWeight="Bold"
                                           Foreground="White" VerticalAlignment="Center" Margin="12,0,0,0" />
                            </StackPanel>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Dot" Property="Background" Value="#EDE7E1" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>

            <!-- крупный номер трека -->
            <TextBlock x:Name="HeroIndex" Grid.Column="0" FontSize="66" FontWeight="Bold"
                       Foreground="{DynamicResource TextBrush}" Margin="38,0,0,-2" VerticalAlignment="Bottom" />

            <!-- «далее»: белые карточки поверх нижнего края обложки + круглые стрелки -->
            <StackPanel Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right"
                        VerticalAlignment="Bottom" Margin="0,0,26,0">
                <ItemsControl x:Name="UpNext">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Width="170" Height="74" Background="White" Margin="0,0,10,0" Padding="14,12"
                                    Cursor="Hand" MouseLeftButtonUp="UpNext_Click" Tag="{Binding}">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.12" Color="#2D2926" />
                                </Border.Effect>
                                <Grid>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="Bold" Foreground="#2D2926"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Artist}" FontSize="11.5" Foreground="#6F655E"
                                                   TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <Path Data="{StaticResource IconChevronRight}" Width="13" Height="13" Stretch="Uniform"
                                          Stroke="#3A4129" StrokeThickness="2.2" StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                          HorizontalAlignment="Right" VerticalAlignment="Bottom" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Button Style="{StaticResource BtnRound}" Click="Prev_Click" ToolTip="Предыдущий" Margin="14,0,0,22">
                    <Path Data="{StaticResource IconChevronRight}" Width="12" Height="12" Stretch="Uniform"
                          Stroke="White" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          RenderTransformOrigin="0.5,0.5">
                        <Path.RenderTransform>
                            <ScaleTransform ScaleX="-1" />
                        </Path.RenderTransform>
                    </Path>
                </Button>
                <Button Style="{StaticResource BtnRound}" Click="Next_Click" ToolTip="Следующий" Margin="10,0,0,22">
                    <Path Data="{StaticResource IconChevronRight}" Width="12" Height="12" Stretch="Uniform"
                          Stroke="White" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- ================= заголовок ================= -->
        <Grid Grid.Row="1" Margin="40,18,26,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock x:Name="HeaderTitle" Text="Библиотека" Style="{StaticResource TextH2}" />
                <TextBlock x:Name="HeaderSubtitle" Text="пока пусто" Style="{StaticResource TextMuted}"
                           Margin="1,5,0,0" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <ComboBox x:Name="SortBox" Width="176" SelectionChanged="SortBox_SelectionChanged"
                          ToolTip="Сортировка">
                    <ComboBoxItem Content="Недавно добавленные" Tag="added" />
                    <ComboBoxItem Content="По названию" Tag="title" />
                    <ComboBoxItem Content="По исполнителю" Tag="artist" />
                    <ComboBoxItem Content="По альбому" Tag="album" />
                    <ComboBoxItem Content="По длительности" Tag="duration" />
                    <ComboBoxItem Content="По прослушиваниям" Tag="plays" />
                </ComboBox>
                <Button Style="{StaticResource BtnPrimary}" Margin="10,0,0,0" Click="Add_Click">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconPlus}" Width="17" Height="17" Stretch="Uniform"
                              Stroke="White" StrokeThickness="2.1" StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round" />
                        <TextBlock Text="Добавить" FontWeight="SemiBold" Margin="8,0,0,0" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- ================= список ================= -->
        <Grid Grid.Row="2" Margin="28,0,18,0">
            <ListBox x:Name="TrackList" ItemTemplate="{StaticResource TrackRowTemplate}"
                     ItemContainerStyle="{StaticResource TrackItem}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     VirtualizingPanel.IsVirtualizing="True"
                     VirtualizingPanel.VirtualizationMode="Recycling"
                     VirtualizingPanel.ScrollUnit="Pixel"
                     controls:SmoothScroll.IsEnabled="True"
                     Background="Transparent" BorderThickness="0" />

            <!-- пустое состояние -->
            <StackPanel x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center"
                        Visibility="Collapsed" MaxWidth="420">
                <Border Width="96" Height="96" CornerRadius="30" Background="{DynamicResource AccentFaintBrush}"
                        BorderBrush="{DynamicResource AccentBorderBrush}" BorderThickness="1"
                        HorizontalAlignment="Center">
                    <Path x:Name="EmptyIcon" Data="{StaticResource IconNote}" Width="44" Height="44" Stretch="Uniform"
                          Stroke="{DynamicResource AccentTextBrush}" StrokeThickness="1.4"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock x:Name="EmptyTitle" Text="Здесь пока пусто" Style="{StaticResource TextH3}"
                           HorizontalAlignment="Center" Margin="0,20,0,0" />
                <TextBlock x:Name="EmptyText" Style="{StaticResource TextMuted}" TextAlignment="Center"
                           TextWrapping="Wrap" Margin="0,8,0,0"
                           Text="Добавьте свои MP3-файлы или папку — приложение соберёт библиотеку автоматически." />
                <Button x:Name="EmptyButton" Style="{StaticResource BtnPrimary}" HorizontalAlignment="Center"
                        Margin="0,22,0,0" Click="Add_Click" Content="Добавить музыку" />
            </StackPanel>
        </Grid>

        <!-- ================= панель воспроизведения ================= -->
        <Border Grid.Row="3" Margin="28,12,26,22" CornerRadius="4" Background="#FBF8F5" ClipToBounds="True">
            <Border.Effect>
                <DropShadowEffect BlurRadius="30" ShadowDepth="6" Opacity="0.14" Color="#2D2926" />
            </Border.Effect>
            <Border.Resources>
                <SolidColorBrush x:Key="TextBrush" Color="#2D2926" />
                <SolidColorBrush x:Key="TextMutedBrush" Color="#6F655E" />
                <SolidColorBrush x:Key="TextFaintBrush" Color="#9A8F87" />
                <SolidColorBrush x:Key="HairlineBrush" Color="#1F2D2926" />
                <SolidColorBrush x:Key="HoverBrush" Color="#122D2926" />
                <SolidColorBrush x:Key="PressedBrush" Color="#1F2D2926" />
                <SolidColorBrush x:Key="AccentTextBrush" Color="#3A4129" />
                <SolidColorBrush x:Key="AccentSofterBrush" Color="#1A555F3C" />
            </Border.Resources>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="30" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- спектр -->
                <controls:SpectrumVisualizer x:Name="Spectrum" Grid.Row="0" Height="30" Margin="16,8,16,0"
                                             Active="True" Opacity="0.85" />

                <!-- управление: слева «сейчас играет», по центру кнопки, справа звук -->
                <Grid Grid.Row="1" Margin="16,2,16,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- слева: винил + название -->
                    <Grid Grid.Column="0" Margin="0,0,12,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0" Width="60" Height="60" VerticalAlignment="Center">
                            <Ellipse Width="58" Height="58" Fill="#0D2D2926" Stroke="{DynamicResource HairlineBrush}"
                                     StrokeThickness="1" />
                            <Ellipse Width="50" Height="50">
                                <Ellipse.Fill>
                                    <RadialGradientBrush>
                                        <GradientStop Color="#00000000" Offset="0.0" />
                                        <GradientStop Color="#00000000" Offset="0.72" />
                                        <GradientStop Color="#33000000" Offset="0.86" />
                                        <GradientStop Color="#00000000" Offset="1" />
                                    </RadialGradientBrush>
                                </Ellipse.Fill>
                                <Ellipse.RenderTransform>
                                    <RotateTransform x:Name="DiscRotate" CenterX="25" CenterY="25" />
                                </Ellipse.RenderTransform>
                            </Ellipse>
                            <Border x:Name="NowCover" Width="46" Height="46" CornerRadius="999" ClipToBounds="True"
                                    Background="{DynamicResource AccentDeepBrush}">
                                <Grid>
                                    <TextBlock x:Name="NowCoverInitial" Text="♪" FontWeight="SemiBold" FontSize="18"
                                               Foreground="#F0F2FA" HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                    <Image x:Name="NowCoverImage" Stretch="UniformToFill" />
                                </Grid>
                            </Border>
                        </Grid>

                        <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="NowTitle" Text="Ничего не играет" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextBrush}" TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="NowArtist" Text="Добавьте музыку, чтобы начать"
                                       FontSize="12" Foreground="{DynamicResource TextMutedBrush}"
                                       TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                            <StackPanel x:Name="TrackActions" Orientation="Horizontal" Margin="0,7,0,0"
                                        Visibility="Collapsed">
                                <Button x:Name="BtnCover" Style="{StaticResource BtnIconSmall}"
                                        ToolTip="Обложка песни: загрузить или заменить" Click="BtnCover_Click">
                                    <Grid>
                                        <Path Data="{StaticResource IconCrop}" Style="{StaticResource IconBase}"
                                              Width="15" Height="15"
                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                        <ContentControl x:Name="LockCover" Style="{StaticResource ProLockBadge}" />
                                    </Grid>
                                </Button>
                                <Button x:Name="BtnExpand" Style="{StaticResource BtnIconSmall}" Margin="6,0,0,0"
                                        ToolTip="Развернуть обложку на весь экран" Click="BtnExpand_Click">
                                    <Path Data="{StaticResource IconExpand}" Style="{StaticResource IconBase}"
                                          Width="15" Height="15"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                </Button>
                                <Button x:Name="BtnClip" Style="{StaticResource BtnIconSmall}" Margin="6,0,0,0"
                                        ToolTip="Клип на фон песни (MP4, до 5 секунд)" Click="BtnClip_Click">
                                    <Grid>
                                        <Path Data="{StaticResource IconFilm}" Style="{StaticResource IconBase}"
                                              Width="15" Height="15"
                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                        <Ellipse x:Name="ClipDot" Width="6" Height="6" HorizontalAlignment="Right"
                                                 VerticalAlignment="Top" Margin="0,-1,-2,0"
                                                 Fill="{DynamicResource AccentBrush}" Visibility="Collapsed" />
                                        <ContentControl x:Name="LockClip" Style="{StaticResource ProLockBadge}" />
                                    </Grid>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <!-- по центру: транспорт -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                                HorizontalAlignment="Center">
                        <ToggleButton x:Name="ShuffleButton" Style="{StaticResource MiniToggle}"
                                      Click="Shuffle_Click" ToolTip="Перемешать">
                            <Path Data="{StaticResource IconShuffle}" Width="18" Height="18" Stretch="Uniform"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                  StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round" />
                        </ToggleButton>

                        <Button Style="{StaticResource BtnIcon}" Click="Prev_Click" ToolTip="Предыдущий">
                            <Path Data="{StaticResource IconPrev}" Width="22" Height="22" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  Stretch="Uniform" />
                        </Button>

                        <Button x:Name="PlayButton" Width="54" Height="54" Margin="6,0" Cursor="Hand" Click="Play_Click"
                                ToolTip="Играть / пауза">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Grid>
                                        <Border CornerRadius="27" Background="{DynamicResource AccentBrush}" />
                                        <Border x:Name="Glow" CornerRadius="999" Margin="-4"
                                                Background="{DynamicResource AccentGlowBrush}" Opacity="0" />
                                        <Path x:Name="Glyph" Data="{StaticResource IconPlay}" Fill="White"
                                              Width="22" Height="22" Stretch="Uniform" HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Glow" Property="Opacity" Value="0.5" />
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="Glyph" Property="Opacity" Value="0.6" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <Button Style="{StaticResource BtnIcon}" Click="Next_Click" ToolTip="Следующий">
                            <Path Data="{StaticResource IconNext}" Width="22" Height="22" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  Stretch="Uniform" />
                        </Button>

                        <ToggleButton x:Name="RepeatToggle" Style="{StaticResource MiniToggle}"
                                      Click="Repeat_Click" ToolTip="Повтор">
                            <Grid>
                                <Path Data="{StaticResource IconRepeat}" Width="18" Height="18" Stretch="Uniform"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                      StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round" />
                                <TextBlock x:Name="RepeatOne" Text="1" FontSize="9" FontWeight="Bold"
                                           Foreground="{DynamicResource AccentTextBrush}" HorizontalAlignment="Center"
                                           VerticalAlignment="Center" Visibility="Collapsed" />
                            </Grid>
                        </ToggleButton>
                    </StackPanel>

                    <!-- справа: громкость + избранное -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                                HorizontalAlignment="Right" Margin="12,0,0,0">
                        <ToggleButton x:Name="MuteButton" Style="{StaticResource MiniToggle}" Click="Mute_Click"
                                      ToolTip="Без звука">
                            <Path x:Name="VolumeGlyph" Data="{StaticResource IconVolume}" Width="18" Height="18"
                                  Stretch="Uniform"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                  StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round" />
                        </ToggleButton>
                        <Slider x:Name="VolumeSlider" Width="112" Margin="4,0,0,0" Minimum="0" Maximum="100" Value="80"
                                IsMoveToPointEnabled="True" VerticalAlignment="Center"
                                ValueChanged="VolumeSlider_ValueChanged" ToolTip="Громкость" />

                        <ToggleButton x:Name="NowFavorite" Style="{StaticResource MiniToggle}"
                                      Margin="14,0,0,0" Click="NowFavorite_Click" ToolTip="Добавить в избранное">
                            <Path Data="{StaticResource IconHeart}" Width="19" Height="19" Stretch="Uniform" StrokeThickness="1.6"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round">
                                <Path.Style>
                                    <Style TargetType="Path">
                                        <Setter Property="Stroke" Value="{DynamicResource TextMutedBrush}" />
                                        <Setter Property="Fill" Value="Transparent" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                                         Value="True">
                                                <Setter Property="Stroke" Value="{DynamicResource AccentTextBrush}" />
                                                <Setter Property="Fill" Value="{DynamicResource AccentBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Path.Style>
                            </Path>
                        </ToggleButton>
                    </StackPanel>
                </Grid>

                <!-- перемотка -->
                <Grid Grid.Row="2" Margin="16,6,16,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="SeekCurrent" Grid.Column="0" Text="0:00" FontSize="11.5"
                               VerticalAlignment="Center" Margin="0,0,10,0"
                               Foreground="{DynamicResource TextFaintBrush}" />
                    <Slider x:Name="SeekSlider" Grid.Column="1" Minimum="0" Maximum="100" Value="0"
                            IsMoveToPointEnabled="True" SmallChange="0.5" LargeChange="5"
                            ValueChanged="SeekSlider_ValueChanged"
                            PreviewMouseLeftButtonDown="SeekSlider_PreviewMouseLeftButtonDown"
                            PreviewMouseLeftButtonUp="SeekSlider_PreviewMouseLeftButtonUp" />
                    <TextBlock x:Name="SeekTotal" Grid.Column="2" Text="0:00" FontSize="11.5"
                               VerticalAlignment="Center" Margin="10,0,0,0"
                               Foreground="{DynamicResource TextFaintBrush}" />
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
