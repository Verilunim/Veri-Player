<Window x:Class="VeriPlayer.Views.ProActivationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Активация Pro+"
        Icon="pack://application:,,,/VeriPlayer;component/Assets/logo.png"
        Width="520" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="Segoe UI Variable Display, Segoe UI, Arial" FontSize="13.5">
    <Border Margin="18" CornerRadius="22" Background="{DynamicResource BgBrush}"
            BorderBrush="#40FFD45C" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="36" ShadowDepth="8" Opacity="0.6" Color="Black" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- заголовок: за него можно перетаскивать окно -->
            <Grid Grid.Row="0" Margin="24,18,14,0" Background="Transparent" MouseLeftButtonDown="Header_MouseDown">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Активация" Style="{StaticResource TextH1}" FontSize="20" VerticalAlignment="Center" />
                    <TextBlock Text="Pro" Style="{StaticResource TextH1}" FontSize="20" Margin="8,0,0,0"
                               Foreground="{StaticResource GoldBrush}" VerticalAlignment="Center" />
                    <TextBlock Style="{StaticResource ProPlusMark}" FontSize="24" Margin="1,-4,0,0" />
                </StackPanel>
                <Button Style="{StaticResource BtnIconSmall}" HorizontalAlignment="Right" ToolTip="Закрыть"
                        Click="Close_Click">
                    <Path Data="{StaticResource IconClose}" Style="{StaticResource IconBase}" Width="15" Height="15"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                </Button>
            </Grid>

            <!-- ввод ключа -->
            <StackPanel x:Name="EntryView" Grid.Row="1" Margin="24,14,24,22">
                <TextBlock x:Name="StatusText" Style="{StaticResource TextMuted}" TextWrapping="Wrap" />

                <TextBlock Text="Ключ активации" Style="{StaticResource FieldLabel}" Margin="2,18,0,6" />
                <TextBox x:Name="KeyInput" Height="84" TextWrapping="Wrap" AcceptsReturn="False"
                         VerticalContentAlignment="Top" FontFamily="Consolas" FontSize="11.5"
                         TextChanged="KeyInput_TextChanged" />
                <TextBlock x:Name="HowTo" Style="{StaticResource TextCaption}" TextWrapping="Wrap" Margin="2,8,0,0" />

                <StackPanel x:Name="ErrorRow" Orientation="Horizontal" Margin="2,12,0,0" Visibility="Collapsed">
                    <Path Data="{StaticResource IconInfo}" Width="16" Height="16" Stretch="Uniform"
                          Stroke="{DynamicResource DangerBrush}" StrokeThickness="1.7"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                          VerticalAlignment="Top" Margin="0,1,0,0" />
                    <TextBlock x:Name="ErrorText" Foreground="{DynamicResource DangerBrush}" FontSize="12.5"
                               TextWrapping="Wrap" Margin="8,0,0,0" MaxWidth="420" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                    <Button Content="Вставить" Style="{StaticResource BtnGhost}" Click="Paste_Click" />
                    <Button x:Name="ActivateButton" Content="Активировать" Style="{StaticResource BtnPrimary}"
                            Margin="10,0,0,0" IsEnabled="False" Click="Activate_Click" />
                </StackPanel>
            </StackPanel>

            <!-- успех -->
            <StackPanel x:Name="DoneView" Grid.Row="1" Margin="24,20,24,24" Visibility="Collapsed">
                <TextBlock Style="{StaticResource ProPlusMark}" FontSize="58" HorizontalAlignment="Center"
                           Margin="0,-6,0,0" ToolTip="{x:Null}" />
                <TextBlock Text="Ключ активирован!" Style="{StaticResource TextH1}" FontSize="20"
                           TextAlignment="Center" Margin="0,6,0,0" />
                <TextBlock x:Name="DoneStatus" Foreground="{StaticResource GoldBrush}" FontWeight="SemiBold"
                           TextAlignment="Center" Margin="0,8,0,0" />
                <TextBlock Style="{StaticResource TextMuted}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,10,0,0"
                           Text="Все функции Pro+ уже открыты. Приветствие подписчика покажем при следующем запуске." />
                <Button Content="Готово" Style="{StaticResource BtnPrimary}" Height="40" Margin="0,20,0,0"
                        Click="Close_Click" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
